# Copy to .env (gitignored) and fill in. `npm run cluster:up` generates the two secrets
# marked "generated" if they are missing.

# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=opspilot

# First admin account, created on the first start
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# Google AI Studio key for the Gemini free tier (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Flash-Lite models have the most generous free quota. With a paid key, a Flash model
# (e.g. gemini-3.8-flash) reasons better.
GEMINI_MODEL=gemini-3.5-flash-lite
# Takes over when the main model is overloaded or out of quota
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Stay under the free tier's limits
LLM_REQUESTS_PER_MINUTE=8
LLM_DAILY_REQUEST_BUDGET=200

# Signs session cookies (generated)
SESSION_SECRET=
# Shared secret Alertmanager sends with every webhook call (generated)
ALERTMANAGER_WEBHOOK_TOKEN=

# kubectl context of the local cluster. Leave unset when OpsPilot runs inside the cluster.
KUBE_CONTEXT=opspilot

# Everything below has working defaults for the local minikube setup
# PORT=4000
# PROMETHEUS_URL=http://localhost:19090
# LOKI_URL=http://localhost:13100
# TEMPO_URL=http://localhost:13200
# ALERTMANAGER_URL=http://localhost:19093
# MONITORED_NAMESPACE=shop
# CORRELATION_WINDOW_MINUTES=5
# AUTO_RESOLVE_MINUTES=5
# INVESTIGATION_DELAY_SECONDS=60
# Folder of Markdown runbooks, indexed on every start (default: runbooks/ in this repository)
# RUNBOOKS_DIR=
