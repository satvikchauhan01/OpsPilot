{
  "name": "opspilot",
  "version": "0.1.0",
  "private": true,
  "description": "AI incident response and reliability copilot for Kubernetes",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,mjs,css}\"",
    "cluster:up": "node scripts/cluster.mjs up",
    "cluster:stop": "node scripts/cluster.mjs stop",
    "cluster:down": "node scripts/cluster.mjs down",
    "cluster:status": "node scripts/cluster.mjs status",
    "scenario": "node scripts/scenario.mjs",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
