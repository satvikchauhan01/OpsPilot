# Settings for `npm run cloud` (see docs/DEPLOYMENT.md). Copy to .env.cloud (gitignored) and
# fill it in. The two generated secrets are written on the first run.

# How to reach the VM over SSH, and the key and port if they aren't the defaults
CLOUD_SSH=ubuntu@203.0.113.10
# CLOUD_SSH_KEY=~/.ssh/opspilot-vm
# CLOUD_SSH_PORT=22

# The public host name, already pointing at the VM (e.g. a free DuckDNS subdomain)
DOMAIN=opspilot.duckdns.org

# The same kinds of settings as .env. Add the VM's public IP to the Atlas access list.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=opspilot
GEMINI_API_KEY=
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password
# ADMIN_NAME=

# Generated
SESSION_SECRET=
ALERTMANAGER_WEBHOOK_TOKEN=
